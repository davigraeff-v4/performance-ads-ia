{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PerformanceAdsOperationDossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "version",
    "status",
    "type",
    "client_slug",
    "platform",
    "active_platforms",
    "source_modes",
    "created_at",
    "updated_at",
    "scope",
    "accounts",
    "currencies",
    "timezones",
    "sources",
    "route",
    "changes",
    "approval",
    "execution"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "operation_id": {"type": "string", "pattern": "^op-[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "proposed", "approved", "executing", "executed", "partial_failure", "failed", "reverted", "analysis_only", "blocked"]},
    "type": {"enum": ["configuracao", "onboarding", "pesquisa_palavras_chave", "planejamento", "criacao", "auditoria", "analise", "otimizacao", "aprovacao", "execucao", "reversao", "relatorio"]},
    "client_slug": {"type": "string", "minLength": 1},
    "platform": {"enum": ["meta", "google_ads", "cross_channel"]},
    "active_platforms": {
      "type": "array",
      "items": {"enum": ["meta", "google_ads"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "source_modes": {"$ref": "#/definitions/platformSourceMap"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "accounts": {"$ref": "#/definitions/platformNullableStringMap"},
    "currencies": {"$ref": "#/definitions/platformNullableStringMap"},
    "timezones": {"$ref": "#/definitions/platformNullableStringMap"},
    "sources": {"type": "array", "items": {"type": "string"}},
    "route": {"$ref": "#/definitions/route"},
    "changes": {
      "type": "array",
      "items": {"$ref": "#/definitions/change"}
    },
    "approval": {"$ref": "#/definitions/approval"},
    "execution": {"$ref": "#/definitions/execution"}
  },
  "definitions": {
    "platformSourceMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "meta": {"enum": ["connected_read", "file_based", "context_only", "unavailable"]},
        "google_ads": {"enum": ["connected_read", "file_based", "context_only", "unavailable"]}
      },
      "minProperties": 1
    },
    "platformNullableStringMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "meta": {"type": ["string", "null"]},
        "google_ads": {"type": ["string", "null"]}
      },
      "minProperties": 1
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["router_version", "intent", "route_ids", "output_contracts", "planned_skills", "executed_skills", "skipped_skills", "gates", "final_state"],
      "properties": {
        "router_version": {"type": "string"},
        "intent": {"type": "string"},
        "route_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z_]+:(meta|google_ads):(connected_read|file_based|context_only|unavailable)$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "output_contracts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "meta": {"type": "string", "minLength": 1},
            "google_ads": {"type": "string", "minLength": 1}
          },
          "minProperties": 1
        },
        "planned_skills": {"type": "array", "items": {"type": "string"}},
        "executed_skills": {"type": "array", "items": {"type": "string"}},
        "skipped_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skill", "reason"],
            "properties": {
              "skill": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        },
        "gates": {"type": "array", "items": {"type": "string"}},
        "final_state": {"enum": ["analysis_only", "proposed", "approved", "executed_or_failure", "blocked_manual_only", "blocked"]}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "finding_ids",
        "platform",
        "target_type",
        "target_ref",
        "field",
        "before",
        "after",
        "rationale",
        "evidence",
        "expected_impact",
        "financial_impact",
        "confidence",
        "risk",
        "rollback",
        "preconditions",
        "dependencies",
        "order",
        "owner",
        "evaluation_window",
        "success_criteria",
        "stop_criteria",
        "execution_mode"
      ],
      "properties": {
        "change_id": {"type": "string"},
        "finding_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "platform": {"enum": ["meta", "google_ads"]},
        "target_type": {"enum": ["campaign", "adset", "ad_group", "ad", "creative", "audience", "keyword", "negative_keyword", "asset", "asset_group", "conversion_action", "campaign_budget", "account_setting"]},
        "target_ref": {"type": "string"},
        "field": {"type": "string"},
        "before": {},
        "after": {},
        "rationale": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "expected_impact": {"type": "string"},
        "financial_impact": {"type": ["number", "null"]},
        "confidence": {"enum": ["alta", "media", "baixa"]},
        "risk": {"type": "string"},
        "rollback": {"type": "string"},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "order": {"type": "integer", "minimum": 1},
        "owner": {"type": ["string", "null"]},
        "evaluation_window": {"type": ["string", "null"]},
        "success_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "stop_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "execution_mode": {"enum": ["mcp", "manual_only", "blocked"]}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approved_by", "approved_at", "version", "hash", "statement"],
      "properties": {
        "approved": {"type": "boolean"},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "version": {"type": ["integer", "null"]},
        "hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "statement": {"type": ["string", "null"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "results", "post_snapshot"],
      "properties": {
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["change_id", "status"],
            "properties": {
              "change_id": {"type": "string"},
              "status": {"enum": ["success", "failed", "not_attempted"]},
              "message": {"type": ["string", "null"]},
              "timestamp": {"type": ["string", "null"], "format": "date-time"}
            },
            "additionalProperties": false
          }
        },
        "post_snapshot": {"type": ["object", "null"]}
      }
    }
  }
}
