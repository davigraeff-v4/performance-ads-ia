{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PerformanceAdsAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "source_mode", "scope", "extracted_at", "timezone", "currency", "window", "comparison_window", "attribution", "measurement_gate", "sources", "findings", "limitations"],
  "properties": {
    "platform": {"enum": ["meta", "google_ads", "cross_channel"]},
    "active_platforms": {"type": "array", "items": {"enum": ["meta", "google_ads"]}, "uniqueItems": true},
    "source_mode": {"enum": ["connected_read", "file_based", "context_only", "mixed", "unavailable"]},
    "scope": {"type": "string"},
    "extracted_at": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string"},
    "currency": {"type": "string"},
    "window": {"$ref": "#/definitions/window"},
    "comparison_window": {"oneOf": [{"$ref": "#/definitions/window"}, {"type": "null"}]},
    "attribution": {"type": ["string", "null"]},
    "measurement_gate": {"enum": ["confiavel", "utilizavel_com_ressalvas", "insuficiente"]},
    "sources": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "object", "additionalProperties": {"type": ["number", "string", "null"]}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["classification", "statement", "evidence", "confidence"],
        "properties": {
          "classification": {"enum": ["F", "C", "H", "R", "I"]},
          "statement": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["alta", "media", "baixa"]},
          "limitation": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    }
  }
}
