# Copie para .env (ja ignorado pelo Git) e preencha com valores locais.
# Nunca commitar este arquivo preenchido.

# --- Google Tag Manager (integrations/gtm) ---
# Caminho local para o client secret OAuth baixado do Google Cloud Console.
# O arquivo em si tambem fica fora do Git (ver .gitignore: credentials/).
PERFORMANCE_ADS_GTM_CREDENTIALS_PATH=credentials/gtm-oauth-client-secret.json

# Onde o token OAuth do usuario e cacheado apos o primeiro login local.
PERFORMANCE_ADS_GTM_TOKEN_CACHE_PATH=credentials/gtm-oauth-token.json

# Capabilities declaradas: reporting (leitura) e/ou tag_management
# (criar/editar tags, triggers e variaveis em rascunho de workspace).
# Nao existe capability de publicacao: esta integracao nunca publica.
PERFORMANCE_ADS_GTM_DECLARED_CAPABILITIES=reporting

# disabled (padrao) | validate_only | execute
# Mesmo com execute, o escopo OAuth solicitado e o codigo nunca incluem
# tagmanager.publish — criar/editar fica sempre em rascunho (workspace),
# publicacao continua manual pela UI do GTM.
PERFORMANCE_ADS_GTM_WRITE_MODE=disabled

# CSV de container IDs autorizados localmente para escrita (obrigatorio
# quando write_mode != disabled).
PERFORMANCE_ADS_GTM_ALLOWED_CONTAINER_IDS=
