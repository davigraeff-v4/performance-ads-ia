# Copiado para ~/.mcp/google-ads/.env pelo install.sh (permissão 600).
# Preencha lá, nunca neste arquivo do repositório.

GOOGLE_ADS_AUTH_TYPE=oauth
# Caminho absoluto do token gerado por gerar_token.py (o Claude não expande ~)
GOOGLE_ADS_CREDENTIALS_PATH=/Users/SEU_USUARIO/.mcp/google-ads/google_ads_token.json
# Central de API da MCC: Ferramentas > Configuração > Central de API
GOOGLE_ADS_DEVELOPER_TOKEN=SEU_DEVELOPER_TOKEN
# MCC padrão de entrada, 10 dígitos sem traço
GOOGLE_ADS_LOGIN_CUSTOMER_ID=0000000000
GOOGLE_ADS_API_VERSION=v26

# execute (grava quando validate_only=false) | validate_only (nunca grava) | disabled
# Comece em validate_only; troque para execute depois de testar.
GOOGLE_ADS_WRITE_MODE=validate_only
# Exclusões (remove/REMOVED) ficam bloqueadas. O contrato do agent proíbe liberar.
GOOGLE_ADS_ALLOW_REMOVE=false
